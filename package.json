{
  "name": "crystal-structures",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite -c vite.v2.config.mjs",
    "build": "vite build -c vite.v2.config.mjs",
    "preview": "vite preview -c vite.v2.config.mjs",
    "test": "node --test v2/src/*.test.mjs && python3 -m pytest -q tests",
    "perf": "node v2/perf/perf-check.mjs",
    "data": "python build/build_structures.py && python build/write_refs.py",
    "v2:data": "python build/build_structures.py && python build/write_refs.py",
    "v2:dev": "vite -c vite.v2.config.mjs",
    "v2:build": "vite build -c vite.v2.config.mjs",
    "v2:test": "node --test v2/src/*.test.mjs && python3 -m pytest -q tests",
    "v2:perf": "node v2/perf/perf-check.mjs",
    "legacy:dev": "node scripts/dev-server.mjs",
    "legacy:vite": "vite",
    "legacy:build": "tsc -b && vite build",
    "legacy:preview": "vite preview",
    "legacy:test": "node --test test/*.test.mjs",
    "legacy:fetch:materials": "node scripts/fetch-materials.mjs",
    "legacy:verify": "node scripts/verify.mjs",
    "legacy:smoke:dev": "node scripts/smoke-dev.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
